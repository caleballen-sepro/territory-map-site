{{/* One page per specialist at /s/<name>/ (rory-roten, alexis-fischer, ...), made from the division data. The page layout is layouts/specialist/single.html.
     Same rule as partials/specmap.html: slug = the name without credentials; open positions get no page. */}}
{{ $seen := dict }}
{{ range $k, $dd := site.Data.divisions }}
  {{ $people := slice }}
  {{ range $dd.national }}{{ $people = $people | append . }}{{ end }}
  {{ range $dd.territories }}{{ range .contacts }}{{ $people = $people | append . }}{{ end }}{{ range .managers }}{{ $people = $people | append . }}{{ end }}{{ end }}
  {{ range $people }}{{ $n := strings.TrimSpace .name }}
    {{ if and $n (not .open) (not (findRE `(?i)^open\b` $n)) }}
      {{ $slug := urlize (strings.TrimSpace (index (split $n ",") 0)) }}
      {{ if not (isset $seen $slug) }}
        {{ $seen = merge $seen (dict $slug true) }}
        {{ $.AddPage (dict "path" $slug "title" $n "kind" "page" "type" "specialist" "description" (printf "%s, SEPRO Scientific. Phone, email and an Add to Contacts button." $n) "params" (dict "person" $n "slug" $slug)) }}
      {{ end }}
    {{ end }}
  {{ end }}
{{ end }}
